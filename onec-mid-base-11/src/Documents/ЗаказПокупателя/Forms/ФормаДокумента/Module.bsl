#Область ОбработчикиСобытийЭлементовФормы
//++Захаров В.С. Командная разарботка EDT Задача 2 20.06.2026
&НаКлиенте
Процедура ВЗ_СогласованнаяСкидкаПриИзменении()
	
	Если Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНаКлиенте", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменен процент скидки. Пересчитать таблицы Товары и Услуги?'"),Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаНаКлиенте(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		
		ПересчитатьТаблицу(Объект.Товары);
		ПересчитатьТаблицу(Объект.Услуги);
		
	КонецЕсли;
	
КонецПроцедуры
//--Захаров В. С.


#КонецОбласти


