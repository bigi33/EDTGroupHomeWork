#Область СлужебныеПроцедурыИФункции

//Командная разарботка EDT Задача 2 20.06.2026
&НаКлиенте
Процедура ПересчитатьТаблицу(Таблица)
	
	Для каждого Строка Из Таблица Цикл
		
		Строка.Скидка = Объект.ВЗ_СогласованнаяСкидка; 
		РассчитатьСуммуСтроки(Строка);
		
	КонецЦикла;
	
КонецПроцедуры 
//--Захаров В. С.
&НаКлиенте



&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	//++Захаров В.С. Командная разарботка EDT Задача 2 20.06.2026
	КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	//--Захаров В. С.
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

